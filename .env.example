# Copy to .env and fill in. NEVER commit .env.
# In CI these are GitHub Actions encrypted secrets (Settings -> Secrets and variables -> Actions).

# --- Anthropic (Claude) -------------------------------------------------
# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model used for quote extraction and caption generation.
ANTHROPIC_MODEL=claude-opus-5

# --- Turso (SQLite) -----------------------------------------------------
# https://turso.tech -> create database -> "Connect"
# Leave both blank locally to fall back to a local SQLite file (see LOCAL_DB_PATH).
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Local-only fallback DB used when TURSO_DATABASE_URL is unset (tests, dev).
LOCAL_DB_PATH=local.db

# --- Instagram / Meta Graph API ----------------------------------------
# See README "External setup" — requires a Professional IG account linked to a FB Page.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# App credentials, needed only by scripts/refresh_ig_token.py
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Image hosting ------------------------------------------------------
# Public base URL that serves the /images directory of this repo.
# raw.githubusercontent.com form (default, no Pages build needed):
IMAGE_BASE_URL=https://raw.githubusercontent.com/OWNER/paragliding-quote-bot/main/images
# GitHub Pages form (if Pages is enabled instead):
# IMAGE_BASE_URL=https://OWNER.github.io/paragliding-quote-bot/images

# --- Behaviour ----------------------------------------------------------
# Set to 1 to skip the real Graph API publish call (everything else still runs).
DRY_RUN=0
LOG_LEVEL=INFO
